+const windowsHideSpawnOptions = { windowsHide: true, windowsUseConpty: false } as const
+
+const windowsKillProcessTree = (
+  pid: number | undefined,
+  callback: (error?: Error | null) => void
+): void => {
+  const numericPid = Number(pid)
+  if (!Number.isInteger(numericPid) || numericPid <= 0) {
+    callback()
+    return
+  }
+  const scriptPath = NodePath.join(NodeOs.tmpdir(), "t3-hidden-taskkill.vbs")
+  const script =
