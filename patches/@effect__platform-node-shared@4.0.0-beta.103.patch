+  try {
+    NodeFs.writeFileSync(scriptPath, script)
+  } catch {
+    // reuse a previous copy if the temp file is locked
+  }
+  const wscript = NodePath.join(
+    process.env.SystemRoot ?? "C:\\Windows",
+    "System32",
+    "wscript.exe"
+  )
+  NodeChildProcess.execFile(
+    wscript,
+    ["//nologo", "//B", scriptPath, String(numericPid)],
+    { ...windowsHideSpawnOptions, stdio: "ignore" },
+    callback
+  )
